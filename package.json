{
  "name": "affice",
  "productName": "Affice",
  "version": "1.0.0",
  "description": "Affice — a free, open-source office suite with Documents, Sheets and Slides. Opens and saves Microsoft Office, OpenDocument and many more formats.",
  "homepage": "https://github.com/andersxns/affice",
  "repository": {
    "type": "git",
    "url": "https://github.com/andersxns/affice.git"
  },
  "bugs": {
    "url": "https://github.com/andersxns/affice/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Affice contributors",
    "email": "andersxns@users.noreply.github.com",
    "url": "https://github.com/andersxns/affice"
  },
  "private": true,
  "main": "dist-electron/main.cjs",
  "desktopName": "affice.desktop",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "preview:web": "vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "icons": "python3 scripts/make-icons.py",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
